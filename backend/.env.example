# ── Identity ───────────────────────────────────────────────
PORTFOLIO_NAME="I. El Fayk"
PORTFOLIO_TITLE="Full Stack Developer"
PORTFOLIO_BIO="Your bio here — a few sentences about who you are and what you build."
PORTFOLIO_SKILLS="JavaScript,Node.js,React,CSS"

# ── Projects (JSON array encoded as a single string) ────────
# Paste the whole array on one line. Each project needs:
#   id (number), title, description, tech (array), url (string or "")
PROJECTS_JSON='[{"id":1,"title":"Project One","description":"What this project does and why it matters.","tech":["HTML","CSS","JavaScript"],"url":"https://github.com"}]'

# ── Contact ─────────────────────────────────────────────────
# Address where contact form submissions should be forwarded.
# Currently only logged to Vercel Function Logs.
# To enable email delivery: install nodemailer and update api/contact.js.
CONTACT_EMAIL="your@email.com"

# ── Admin ────────────────────────────────────────────────────
# Any strong random string. Used as the password for /admin.html.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET="change-me-to-a-strong-secret"

# ── Vercel (auto-injected — do NOT set manually) ─────────────
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
